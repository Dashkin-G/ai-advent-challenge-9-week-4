# Обязательная переменная — ключ API модели.
DASHSCOPE_API_KEY=

# Модель агента (OpenAI-совместимый режим Model Studio).
# MODEL=qwen3.8-2.4t-a95b

# Репозиторий, вокруг которого работает MCP-сервер.
# GITHUB_REPO=Dashkin-G/ai-advent-challenge-9-week-4

# Токен GitHub не обязателен: публичный репозиторий читается и без него, но
# лимит тогда 60 запросов в час вместо 5000. Если переменной нет, приложение
# спросит токен у GitHub CLI командой `gh auth token`.
# GITHUB_TOKEN=

# Адрес интерфейса и общий порт двух приложений.
# HOST=127.0.0.1
# PORT=8000
